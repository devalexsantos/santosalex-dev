generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// ----------------------------------------------------------------------------
// Admin
// ----------------------------------------------------------------------------

model UserAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// Public content
// ----------------------------------------------------------------------------

enum TranslationStatus {
  draft
  needs_translation
  translated
  reviewed
}

enum ProjectStatus {
  draft
  in_progress
  shipped
  archived
}

enum ProjectCategory {
  saas
  ai
  frontend
  fullstack
  automation
  infra
  experiment
}

model Project {
  id               String          @id @default(cuid())
  slug             String          @unique
  title            String
  shortDescription String
  /// Localized rich content. Shape: { "pt-BR": {...}, "en": {...} }
  /// where each locale carries { fullDescription, problem, hypothesis,
  /// targetAudience, technicalDecisions, learnings, nextSteps }.
  content          Json?
  /// Localized architecture overview. Shape: { "pt-BR": string, "en": string }
  architecture     Json?
  /// Localized challenges section. Shape: { "pt-BR": string, "en": string }
  challenges       Json?
  /// Localized README / deep technical dive. Markdown with optional ```mermaid blocks.
  /// Shape: { "pt-BR": string, "en": string }
  readme           Json?
  coverImage       String?
  demoUrl          String?
  githubUrl        String?
  status           ProjectStatus   @default(draft)
  /// Translation status of the EN content relative to the PT-BR source.
  /// draft = EN never touched; needs_translation = PT was edited after last AI pass;
  /// translated = AI drafted EN, awaiting human review; reviewed = human confirmed.
  translationStatus TranslationStatus @default(draft)
  /// A project can belong to multiple categories so it surfaces in several
  /// filters on the public projects page.
  categories       ProjectCategory[]
  year             Int?
  featured         Boolean         @default(false)
  order            Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  features  ProjectFeature[]
  decisions ProjectDecision[]
  stack     ProjectStack[]
  images    ProjectImage[]

  @@index([featured, order])
}

model ProjectImage {
  id        String  @id @default(cuid())
  projectId String
  /// Public S3 URL of the uploaded image.
  url       String
  /// Optional caption shown beneath the image in the public gallery.
  caption   String?
  order     Int     @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, order])
}

model ProjectFeature {
  id          String  @id @default(cuid())
  projectId   String
  /// Bilingual title. Shape: { "pt-BR": string, "en": string }
  title       Json
  /// Bilingual description. Shape: { "pt-BR": string, "en": string }
  description Json
  order       Int     @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, order])
}

model ProjectDecision {
  id          String  @id @default(cuid())
  projectId   String
  /// Bilingual title. Shape: { "pt-BR": string, "en": string }
  title       Json
  /// Bilingual description. Shape: { "pt-BR": string, "en": string }
  description Json
  /// Bilingual reason. Shape: { "pt-BR": string, "en": string }
  reason      Json
  order       Int     @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, order])
}

model ProjectStack {
  id           String @id @default(cuid())
  projectId    String
  technologyId String

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@unique([projectId, technologyId])
}

enum TechnologyCategory {
  frontend
  backend
  database
  ai
  devops
  infra
  automation
  payments
  email
  testing
  other
}

enum ExperienceLevel {
  learning
  intermediate
  advanced
  expert
}

model Technology {
  id              String             @id @default(cuid())
  slug            String             @unique
  name            String
  category        TechnologyCategory
  icon            String?
  description     String?
  experienceLevel ExperienceLevel    @default(intermediate)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  projects ProjectStack[]
}

// ----------------------------------------------------------------------------
// Blog / Build Notes
// ----------------------------------------------------------------------------

enum PostCategory {
  architecture
  ai
  saas
  frontend
  backend
  infra
  product
  experiment
  deploy
  performance
}

model Post {
  id                 String       @id @default(cuid())
  /// Uniqueness is enforced together with locale via @@unique([locale, slug])
  /// so pt-BR and en versions can share the same slug string.
  slug               String
  /// Locale code: "pt-BR" or "en"
  locale             String
  /// Groups translated versions of the same post
  translationGroupId String
  title              String
  excerpt            String
  content            String
  category           PostCategory
  tags               String[]
  coverImage         String?
  readingTime        Int?
  published          Boolean      @default(false)
  publishedAt        DateTime?
  /// Translation status. Meaningful on the EN row; PT rows are the source and
  /// are set to `reviewed` automatically on save (they don't need translation).
  translationStatus  TranslationStatus @default(draft)
  seoTitle           String?
  seoDescription     String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([locale, slug])
  @@index([translationGroupId])
  @@index([published, publishedAt])
}

// ----------------------------------------------------------------------------
// RAG
// ----------------------------------------------------------------------------

enum AiDocumentSourceType {
  project
  post
  profile
  experience
  faq
  page
}

model AiDocument {
  id         String               @id @default(cuid())
  title      String
  sourceType AiDocumentSourceType
  sourceId   String?
  /// Locale of the document content
  locale     String
  content    String
  metadata   Json?
  indexed    Boolean              @default(false)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  chunks AiChunk[]

  @@unique([sourceType, sourceId, locale])
  @@index([indexed])
}

model AiChunk {
  id         String                       @id @default(cuid())
  documentId String
  content    String
  /// Vector dimension must match AI_EMBEDDING_DIMENSIONS (default 1536)
  embedding  Unsupported("vector(1536)")?
  metadata   Json?
  locale     String
  createdAt  DateTime                     @default(now())

  document AiDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([locale])
}

enum ChatRole {
  user
  assistant
  system
}

model AiChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      ChatRole
  content   String
  ipHash    String?
  locale    String?
  createdAt DateTime @default(now())

  feedback AiFeedback[]

  @@index([sessionId, createdAt])
}

model AiFeedback {
  id        String   @id @default(cuid())
  messageId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  message AiChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

// ----------------------------------------------------------------------------
// Profile (singleton + related tables)
// ----------------------------------------------------------------------------

/// Singleton row — one Profile per portfolio. id is forced to "singleton".
model Profile {
  id           String   @id @default("singleton")
  /// Bilingual tagline. Shape: { "pt-BR": string, "en": string }
  tagline      Json
  /// Bilingual long-form bio (1-3 paragraphs). Shape: { "pt-BR": string, "en": string }
  bio          Json
  /// Bilingual "how I work" / approach. Shape: { "pt-BR": string, "en": string }
  approach     Json
  /// Optional plain string — same for both locales
  location     String?
  /// Optional plain string — "Disponível para freelance/contrato/CLT", "Aberto a remoto", etc.
  availability String?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

model ProfileRoleType {
  id          String   @id @default(cuid())
  /// e.g. "Fullstack Developer" / { "pt-BR": "...", "en": "..." }
  title       Json
  /// Paragraph explaining why Alex fits this role. Bilingual.
  description Json
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProfileExperience {
  id         String   @id @default(cuid())
  /// Company name — same string in both locales
  company    String
  /// Bilingual role title
  role       Json
  /// Free-form period string, e.g. "2023 — atual" / "2023 — present"
  period     String
  /// Bilingual highlights paragraph
  highlights Json
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ProfileFaq {
  id        String   @id @default(cuid())
  /// Bilingual question
  question  Json
  /// Bilingual answer
  answer    Json
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// Contact
// ----------------------------------------------------------------------------

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
